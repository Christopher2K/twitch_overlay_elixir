<div class="w-full flex flex-col justify-start items-start gap-4 p-4">
  <h1 class="font-bold text-2xl">Overlay twitch by LLCoolChris_</h1>
  <div class="flex flex-col justify-start items-start gap-10">
    <div class='flex flex-col justify-start items-start'>
      <h2 class='mb-2 text-xl'>Transition overlays (horizontal)</h2>

      <a class="hover:underline" href={~p"/overlay/start"}>Start overlay</a>
      <a class="hover:underline" href={~p"/overlay/brb"}>BRB overlay</a>
      <a class="hover:underline" href={~p"/overlay/end"}>End overlay</a>
    </div>

    <div class='flex flex-col justify-start items-start'>
      <h2 class='mb-2 text-xl'>Content overlays (horizontal)</h2>

      <a class="hover:underline" href={~p"/overlay/computer"}>Computer overlay</a>
      <a class="hover:underline" href={~p"/overlay/computer-small"}>Laptop overlay</a>
      <a class="hover:underline" href={~p"/overlay/talk"}>Talk overlay</a>
    </div>

    <div class='flex flex-col justify-start items-start'>
      <h2 class='mb-2 text-xl'>Guest overlays</h2>

      <a class="hover:underline" href={~p"/overlay/audio-guest"}>Audio guest overlay</a>
      <a class="hover:underline" href={~p"/overlay/video-guest"}>Video guest overlay</a>
      <a class="hover:underline" href={~p"/overlay/computer-guest"}>Computer guest overlay</a>
    </div>

    <div class='flex flex-col justify-start items-start'>
      <h2 class='mb-2 text-xl'>Utility overlays</h2>

      <a class="hover:underline" href={~p"/overlay/alerts"}>Alerts overlay</a>
    </div>

    <div class='flex flex-col justify-start items-start'>
      <h2 class='mb-2 text-xl'>Transition overlays (vertical)</h2>

      <a class="hover:underline" href={~p"/overlay/vertical/start"}>Start vertical overlay</a>
      <a class="hover:underline" href={~p"/overlay/vertical/brb"}>BRB vertical overlay</a>
      <a class="hover:underline" href={~p"/overlay/vertical/end"}>End vertical overlay</a>
    </div>

    <div class='flex flex-col justify-start items-start'>
      <h2 class='mb-2 text-xl'>Content overlays (vertical)</h2>

      <a class="hover:underline" href={~p"/overlay/vertical/computer"}>Computer vertical overlay</a>
      <a class="hover:underline" href={~p"/overlay/vertical/talk"}>Talk vertical overlay</a>
    </div>
  </div>
</div>
